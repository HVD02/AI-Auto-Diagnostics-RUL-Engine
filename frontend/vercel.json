
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ai-auto-diagnostics-backend.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://ai-auto-diagnostics-backend.onrender.com/static/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}